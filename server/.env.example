# Server-only secrets. Copy to server/.env (gitignored).
# Never prefix these with EXPO_PUBLIC_ — they would leak in the APK/web bundle.
#
# 1. Atlas Network Access: allow 0.0.0.0/0 (Vercel Hobby egress is not static).
# 2. Cloudflare R2: enable R2 in the dashboard, create bucket scalerone-images,
#    enable Public Development URL, create an S3 API token (Object Read & Write).
# 3. Hugging Face token for CLIP (openai/clip-vit-base-patch32).
# 4. Optional: Firebase Admin JSON for real ID tokens (FIREBASE_SERVICE_ACCOUNT).
# 5. Gemini API key (Google AI Studio, free tier, no card required) for
#    Lost & Found photo analysis/autofill — aistudio.google.com/apikey.

MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ScalerOne
MONGODB_DB=ScalerOne

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=scalerone-images
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

HF_TOKEN=

GEMINI_API_KEY=

FIREBASE_SERVICE_ACCOUNT=

ALLOW_MOCK_AUTH=true
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGINS=
PORT=3001
